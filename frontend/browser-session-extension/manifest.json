{
  "manifest_version": 3,
  "name": "PulsarTeam — Authenticated Browser",
  "version": "1.0.2",
  "description": "Sign in using your browser and explicitly share a website session with your PulsarTeam cluster.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Share with PulsarTeam" }
}
