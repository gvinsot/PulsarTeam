{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(node --import tsx --experimental-test-module-mocks --test:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/package-lock.json)",
      "Read(./docs/archive/**)"
    ]
  }
}
