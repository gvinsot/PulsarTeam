{
  "version": 1,
  "language": "typescript",
  "commands": {
    "build": ["npm", "--prefix", "api", "run", "build"],
    "generated_test": ["node", "--import", "tsx", "--experimental-test-module-mocks", "--test", "{file}"],
    "test": ["npm", "--prefix", "api", "test"],
    "typecheck": ["npm", "--prefix", "api", "run", "typecheck"]
  },
  "sandbox": {
    "image": "pulsarteam-swiftproof:local",
    "network": false,
    "timeout_seconds": 900,
    "max_runtime_seconds": 2400,
    "max_output_bytes": 262144,
    "memory_mb": 4096,
    "cpus": 4
  },
  "reviewer": {
    "endpoint": "",
    "model": "",
    "api_key_env": "SWIFTPROOF_API_KEY",
    "max_iterations": 20,
    "max_generated_tests": 10,
    "timeout_seconds": 600,
    "max_input_bytes": 131072
  },
  "sensitive_paths": [
    "**/auth/**",
    "**/migrations/**",
    "**/Dockerfile",
    ".github/workflows/**",
    ".swiftproof.json",
    "devops/**",
    "docker-compose.yml",
    "api/src/secrets.ts",
    "api/src/middleware/**",
    "api/src/lib/agentAccess.ts",
    "api/src/lib/agentScope.ts",
    "api/src/lib/boardAccess.ts",
    "api/src/lib/crypto.ts",
    "api/src/lib/ssrfGuard.ts",
    "api/src/lib/taskTrust.ts",
    "api/src/routes/apiKeys.ts",
    "api/src/routes/authBrowser.ts",
    "api/src/routes/authLogin.ts",
    "api/src/routes/codexAuth.ts",
    "api/src/routes/insertApi.ts",
    "api/src/routes/internal*.ts",
    "api/src/routes/oauth*.ts",
    "api/src/routes/*OAuth*.ts",
    "api/src/services/apiKeyManager.ts",
    "api/src/services/pulsarGatewayMcp.ts",
    "api/src/services/database/baseSchema.ts",
    "api/src/services/database/migrations.ts",
    "api/src/services/database/schema.ts",
    "api/src/services/execution/**",
    "mcp-auth-browser/src/**",
    "runner-service/src/agent_user.py",
    "runner-service/src/code_executor.py",
    "runner-service/src/command_security.py",
    "runner-service/src/secret_filter.py",
    "runner-service/src/security.py",
    "runner-service/src/swarm_secrets.py"
  ]
}
